									"if (jsonData.access_token) {\r",
									"    pm.collectionVariables.set(\"keycloakAccessToken\", jsonData.access_token);\r",
									"    pm.collectionVariables.set(\"keycloakRefreshToken\", jsonData.refresh_token);\r",
									"    console.log(\"Access token armazenado.\");\r",
									"} else {\r",
									"    pm.test(\"Token de acesso não encontrado\", function () {\r",
									"        throw new Error(\"access_token não encontrado no corpo da resposta.\");\r",
									"    });\r",
									"}\r",
