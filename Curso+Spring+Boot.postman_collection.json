				{
					"name": "Cria um novo usuário no Keycloak",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Captura o cabeçalho 'Location'\r",
									"const locationHeader = pm.response.headers.get(\"Location\");\r",
									"\r",
									"if (locationHeader) {\r",
									"    // Extrai o ID (UUID) do final da URL\r",
									"    const userIdMatch = locationHeader.match(/\\/users\\/([a-f0-9\\-]+)$/);\r",
									"    if (userIdMatch && userIdMatch[1]) {\r",
									"        const userId = userIdMatch[1];\r",
									"        // Salva na variável da collection\r",
									"        pm.collectionVariables.set(\"userCreatedId\", userId);\r",
									"        console.log(\"ID do usuário salvo:\", userId);\r",
									"    } else {\r",
									"        console.warn(\"ID do usuário não encontrado no Location header.\");\r",
									"    }\r",
									"} else {\r",
									"    console.warn(\"Cabeçalho 'Location' não encontrado na resposta.\");\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
